# Copy to .env for local development. On production (e.g. Vercel), set these in the host dashboard.

DATABASE_URL="file:./dev.db"

# Required for admin login sessions (generate: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Admin CMS login — synced to the database on every `npm run build`
ADMIN_LOGIN_EMAIL="info@unitrail-housing.de"
ADMIN_LOGIN_PASSWORD="replace-with-secure-password"
ADMIN_NAME="Admin"

# Inquiry notification recipient (can match ADMIN_LOGIN_EMAIL)
ADMIN_EMAIL="info@unitrail-housing.de"

# Optional: one-time API to set admin without redeploy (POST /api/admin/setup-credentials)
# ADMIN_SETUP_SECRET="long-random-secret"

# Optional SMTP for inquiry emails
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=

# Google Analytics 4 (gtag.js)
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-N0NG22Z9MH"
